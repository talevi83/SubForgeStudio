# Google Gemini API Configuration (Required for Subtitle Translation)
# GEMINI_MODEL / GEMINI_VISION_MODEL are only the initial defaults — choose models and thinking
# levels in the app's Settings screen (saved to storage/settings.json).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BATCH_SIZE=30
# One extra Gemini call per job that builds a character/gender/terminology glossary
GEMINI_GLOSSARY_PASS=true
# On-screen text detection: vision model, seconds between sampled frames, max frames per job
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
ONSCREEN_FRAME_INTERVAL=2.0
ONSCREEN_MAX_FRAMES=360

# Faster-Whisper Local Transcription Defaults
WHISPER_DEFAULT_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# Batched GPU inference (much faster). Lower it if you run out of VRAM; 0 disables.
WHISPER_BATCH_SIZE=8

# Subtitle Formatting Rules
MAX_CHARS_PER_LINE=42
MAX_CPS_WARNING=20.0
TARGET_CPS=17.0
MIN_SUBTITLE_DURATION=1.0
MAX_SUBTITLE_DURATION=7.0

# Paths & Server Configuration
STORAGE_DIR=./storage
DATABASE_URL=sqlite:///./storage/subforge.db
HOST=127.0.0.1
PORT=8000
# If you set HOST=0.0.0.0 for LAN access, add the host names you will use, e.g.
# ALLOWED_HOSTS=["localhost","127.0.0.1","my-pc","192.168.1.20"]
